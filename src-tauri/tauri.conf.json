{
 "$schema": "https://schema.tauri.app/config/2",
 "productName": "voxflow",
 "version": "0.1.0",
 "identifier": "com.voxflow.app",
 "build": {
  "beforeDevCommand": "npm run dev",
  "devUrl": "http://localhost:11494",
  "beforeBuildCommand": "npm run build",
  "frontendDist": "../dist"
 },
 "app": {
  "windows": [
   {
    "title": "VoxFlow",
    "width": 1100,
    "height": 720,
    "minWidth": 900,
    "minHeight": 600,
    "decorations": false,
    "center": true
   }
  ],
  "security": {
   "csp": null
  }
 },
 "bundle": {
  "active": true,
  "targets": [
   "nsis"
  ],
  "icon": [
   "icons/32x32.png",
   "icons/128x128.png",
   "icons/128x128@2x.png",
   "icons/icon.icns",
   "icons/icon.ico"
  ],
  "resources": [],
  "windows": {
   "webviewInstallMode": {
    "type": "downloadBootstrapper"
   },
   "nsis": {
    "installMode": "currentUser",
    "languages": [
     "SimpChinese",
     "English"
    ]
   }
  }
 }
}