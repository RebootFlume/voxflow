{
  "name": "voxflow",
  "version": "0.4.0",
  "description": "VoxFlow - 本地语音识别（ASR）+ 语音合成（TTS）桌面工具 | Electron + React + TypeScript",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "bundle": "powershell -ExecutionPolicy Bypass -File scripts/bundle.ps1",
    "bundle:portable": "powershell -ExecutionPolicy Bypass -File scripts/bundle.ps1",
    "version:sync": "node scripts/bump-version.mjs",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "verify:renderer": "node scripts/verify-renderer.mjs",
    "verify:events": "node scripts/verify-events.mjs",
    "verify:tts": "node scripts/verify-tts-ipc.mjs",
    "verify:runtime": "node scripts/verify-runtime-download.mjs",
    "verify:api": "node scripts/verify-api-server.mjs",
    "install:runtime": "node scripts/install-runtime.mjs",
    "test:tts": "node scripts/run-ts-tests.mjs scripts/tts-tests.ts",
    "test:pytorch": "node scripts/run-ts-tests.mjs scripts/pytorch-tests.ts",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.18.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.5.4",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^8.3.4"
  }
}
